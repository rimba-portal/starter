{
    "name": "bit-es/base",
    "description": "Base package for use by all Bites and Rimba packages.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BIT Ecosystem",
            "email": "bit.ecosystem@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bites\\Base\\BaseServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Bites\\Base\\": "src/"
        }
    },
    "scripts": {
        "bites:make-all-md": [
            "@php artisan bites:quick-md packages\\bit-es\\agreement",
            "@php artisan bites:quick-md packages\\bit-es\\attributing",
            "@php artisan bites:quick-md packages\\bit-es\\calendar",
            "@php artisan bites:quick-md packages\\bit-es\\identity",
            "@php artisan bites:quick-md packages\\bit-es\\siapa",
            "@php artisan bites:quick-md packages\\bit-es\\versioning",
            "@php artisan bites:quick-md packages\\bit-es\\workflow",
            "@php artisan bites:quick-md packages\\rimba\\Bark\\Branding",
            "@php artisan bites:quick-md packages\\rimba\\Bark\\Can",
            "@php artisan bites:quick-md packages\\rimba\\Bark\\Trail",
            "@php artisan bites:quick-md packages\\rimba\\Bark\\Who",
            "@php artisan bites:quick-md packages\\rimba\\Tree\\Flow",
            "@php artisan bites:quick-md packages\\rimba\\Tree\\Link",
            "@php artisan bites:quick-md packages\\rimba\\Tree\\Menu",
            "@php artisan bites:quick-md packages\\rimba\\Tree\\Time",
            "@php artisan bites:quick-md packages\\rimba\\Tree\\Work",
            "@php artisan bites:quick-md packages\\rimba\\Twig\\Dms",
            "@php artisan bites:quick-md packages\\rimba\\Twig\\Eam",
            "@php artisan bites:quick-md packages\\rimba\\Twig\\Hrm",
            "@php artisan bites:quick-md packages\\rimba\\Twig\\Lcs",
            "@php artisan bites:quick-md packages\\rimba\\Twig\\Lms",
            "@php artisan bites:quick-md packages\\rimba\\Twig\\Tos"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}